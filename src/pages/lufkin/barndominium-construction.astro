---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const faqs = [
  { q: 'Are barndominiums popular in the Lufkin, TX area?', a: 'Very. Angelina County and the surrounding East Texas region are prime barndominium country — large rural lots, a country lifestyle, and land that\'s well-suited for the acreage builds where barndominiums thrive. Purpose Construction has built multiple barndominiums in and around Lufkin.' },
  { q: 'What does a barndominium cost in Angelina County?', a: 'Barndominium construction in Angelina County typically ranges from $90–$175 per square foot for the finished living space, depending on finish level, size, and site conditions. Shell-only builds run lower; fully finished custom interiors run higher. We provide a detailed itemized estimate after a site visit.' },
  { q: 'Can I build a barndominium on rural land outside Lufkin?', a: 'Yes. Most rural Angelina County land is well-suited for barndominium construction. We handle site evaluation, septic and well coordination, land clearing, and all required county permits for rural builds outside Lufkin city limits.' },
  { q: 'How long does barndominium construction take?', a: 'A typical barndominium in Angelina County takes 4–8 months from breaking ground to final walkthrough, depending on size and finish level. Shell-only builds move faster. We provide a written construction schedule in every proposal.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Barndominium Construction in Lufkin TX',
    provider: { '@type': 'GeneralContractor', name: 'Purpose Construction', url: 'https://www.purposeconstructionco.com' },
    areaServed: { '@type': 'City', name: 'Lufkin', containedIn: { '@type': 'State', name: 'Texas' } },
    description: 'Barndominium construction in Lufkin, TX and rural Angelina County. Purpose Construction builds custom barndominiums on your land — full-scope from slab to final finishes.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Barndominium Construction in Lufkin, TX | Purpose Construction"
  description="Barndominium builder in Lufkin, TX. Purpose Construction builds custom barndominiums on rural Angelina County land — full-scope from slab to finish. Free estimates — (936) 255-2235."
  schema={schema}
>
  <Breadcrumb items={[
    { label: 'Services', href: '/services' },
    { label: 'New Construction', href: '/new-construction' },
    { label: 'Barndominium Construction', href: '/barndominium-construction' },
    { label: 'Lufkin, TX', href: '/lufkin/barndominium-construction' },
  ]} />

  <PageHero
    title="Barndominium Construction in Lufkin, TX"
    subtitle="Purpose Construction builds custom barndominiums on rural Angelina County land — from concrete slab to finished living space, on your lot, to your plan."
    tag="Lufkin, TX"
    image="/images/barndominium-construction-east-texas.jpg"
  />

  <div class="bg-charcoal-900 border-b border-charcoal-700">
    <div class="container-wide px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm font-semibold text-white">Serving Lufkin & Angelina County — Free on-site estimates, no obligation.</p>
      <div class="flex items-center gap-3">
        <a href="tel:9362552235" class="text-sm font-bold text-brand-red hover:text-white transition-colors duration-150">(936) 255-2235</a>
        <a href="/contact" class="btn-primary py-2.5 text-xs">Get a Free Quote</a>
      </div>
    </div>
  </div>

  <section class="section-padding bg-warm-50">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading tag="Lufkin, TX" title="East Texas Barndominium Country" />
          <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
            <p>Angelina County is exactly the kind of place barndominiums are built for — wide rural lots, a country lifestyle, and landowners who want flexibility in what they build. Purpose Construction's <a href="/barndominium-construction" class="text-brand-red hover:underline font-semibold">barndominium construction</a> team has built throughout the Lufkin area and understands the site-specific requirements of rural Angelina County builds: well and septic coordination, county permits, rural access roads, and site prep on wooded East Texas land.</p>
            <p>We build barndominiums to your floor plan — open living layouts, shop/garage combinations, or fully finished custom interiors with all the amenities of a traditional home. Many clients pair the barndominium living space with a workshop or equipment storage bay in the same structure. If you're also looking at a conventional home build, see our <a href="/lufkin/residential-construction" class="text-brand-red hover:underline font-semibold">residential construction</a> page.</p>
            <p>All rural Angelina County barndominium builds are permitted through the Angelina County Building Department. We handle every permit application, inspection, and engineering requirement from start to finish.</p>
          </div>
          <div class="mt-6 flex gap-4">
            <a href="/contact" class="btn-primary">Get a Free Estimate</a>
            <a href="tel:9362552235" class="btn-outline">Call (936) 255-2235</a>
          </div>
        </div>
        <div class="space-y-5">
          <img
            src="/images/barndominium-construction-east-texas.jpg"
            alt="Barndominium construction in Lufkin TX by Purpose Construction"
            class="rounded-xl shadow-hero w-full"
            width="640" height="480"
            loading="lazy" decoding="async"
          />
          <div class="rounded-xl border border-warm-200 bg-white p-5 shadow-card">
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-charcoal-400">Contact Information</p>
            <p class="text-base font-bold text-charcoal-900">Purpose Construction</p>
            <p class="mt-1 text-sm text-charcoal-600">Lufkin, TX 75904</p>
            <a href="tel:9362552235" class="mt-1 block text-sm font-semibold text-brand-red hover:text-brand-red-dark transition-colors duration-150">(936) 255-2235</a>
            <a href="mailto:info@purposeconstructionco.com" class="mt-0.5 block text-sm text-charcoal-500 hover:text-charcoal-800 transition-colors duration-150">info@purposeconstructionco.com</a>
            <div class="mt-3 border-t border-warm-200 pt-3 text-xs text-charcoal-500">
              <p>Mon–Sat: 8:00 AM – 8:00 PM</p>
              <p>Sunday: Closed</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="What We Handle" title="Full-Scope Barndominium Construction" align="center" />
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {[
          'Metal Building Shell', 'Custom Floor Plan', 'Concrete Slab',
          'Electrical Rough-In', 'Plumbing Rough-In', 'HVAC Systems',
          'Interior Framing', 'Spray Foam Insulation', 'Drywall & Finishes',
          'Kitchen & Bath', 'Exterior Doors & Windows', 'Permit Management',
        ].map((item) => (
          <div class="flex items-center gap-2 rounded-lg border border-warm-200 bg-warm-50 px-4 py-3 text-sm font-semibold text-charcoal-700">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-red" aria-hidden="true"></span>
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-warm-100 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Our Process" title="How Barndominium Construction Works in Lufkin" />
      <ol class="space-y-6">
        {[
          { step: '1', title: 'Free Site Consultation', body: 'We visit your land in Angelina County, assess the site conditions, and discuss your floor plan goals and budget.' },
          { step: '2', title: 'Written Proposal', body: 'Full itemized quote including site prep, shell, mechanical systems, and interior finish level — with a construction phase schedule.' },
          { step: '3', title: 'Permits & Pre-Construction', body: 'Angelina County building permits pulled, engineering coordinated, well/septic arranged if needed, and all subs scheduled.' },
          { step: '4', title: 'Slab, Shell & Framing', body: 'Slab formed, poured, and cured. Metal building shell erected. Interior walls framed and rough mechanical systems run.' },
          { step: '5', title: 'Systems, Interior & Finishes', body: 'All mechanical systems inspected. Spray foam insulation, drywall, finishes, kitchen, bath, and exterior details completed.' },
          { step: '6', title: 'Final Walkthrough & Delivery', body: 'We walk every square foot with you, complete the punch list, and deliver your barndominium when you\'re fully satisfied.' },
        ].map((step) => (
          <li class="flex gap-6 items-start">
            <span class="flex-shrink-0 flex h-9 w-9 items-center justify-center rounded-full bg-brand-red text-white font-display font-bold text-sm" aria-hidden="true">{step.step}</span>
            <div>
              <h3 class="display-sm text-charcoal-900 mb-1">{step.title}</h3>
              <p class="text-sm leading-relaxed text-charcoal-500">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Common Questions" title="Barndominium FAQs — Lufkin, TX" align="center" />
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-warm-200 bg-warm-50 shadow-card">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 list-none">
              <h3 class="text-sm font-semibold text-charcoal-800 pr-4">{faq.q}</h3>
              <svg class="h-5 w-5 flex-shrink-0 text-charcoal-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed text-charcoal-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-warm-50 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also in Lufkin" title="Related Services in Lufkin, TX" />
      <div class="flex flex-wrap gap-3">
        {[
          { label: 'New Construction', href: '/lufkin/new-construction' },
          { label: 'Residential Construction', href: '/lufkin/residential-construction' },
          { label: 'Commercial Construction', href: '/lufkin/commercial-construction' },
          { label: 'Home Additions', href: '/lufkin/home-additions' },
          { label: 'General Contractor', href: '/lufkin/general-contractor' },
        ].map((link) => (
          <a href={link.href} class="rounded-lg border border-warm-200 bg-white px-5 py-3 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-charcoal-900 transition-all duration-200">
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also Serving" title="Nearby Communities" />
      <div class="flex flex-wrap gap-3">
        <a href="/locations/nacogdoches" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Nacogdoches →</a>
        <a href="/locations/diboll" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Diboll →</a>
        <a href="/locations/huntington" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Huntington →</a>
        <a href="/locations/hudson" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Hudson →</a>
        <a href="/locations/zavalla" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Zavalla →</a>
        <a href="/locations" class="rounded-lg border border-brand-red/30 bg-brand-red-light px-5 py-2.5 text-sm font-semibold text-brand-red hover:bg-brand-red hover:text-white transition-all duration-200">All Service Areas →</a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-red">
    <div class="container-mid px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="display-md text-white mb-4">Build Your Barndominium in Lufkin</h2>
      <p class="mx-auto mb-8 max-w-xl text-base text-white/80">Call us or fill out the contact form for a free on-site estimate on your Angelina County land. We serve Lufkin and all of deep East Texas.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact" class="btn-ghost px-8 py-4">Get a Free Quote</a>
        <a href="tel:9362552235" class="text-sm font-semibold text-white/70 hover:text-white transition-colors duration-150">(936) 255-2235</a>
      </div>
    </div>
  </section>
</BaseLayout>
