---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';

const faqs = [
  { q: 'What window brands do you install in Lufkin, TX?', a: 'We install Andersen, Pella, and equivalent-grade vinyl and fiberglass windows rated for hot-humid climates. Window selection in East Texas should prioritize low-E glass coatings and proper SHGC ratings for solar heat gain — standard northern windows are undersized for Lufkin\'s UV load. We spec the right glass package at the estimate.' },
  { q: 'Do I need a permit to replace windows in Lufkin?', a: 'Like-for-like window replacements in the same rough opening typically do not require a permit in Lufkin. Projects that involve enlarging openings or structural changes do. Purpose Construction assesses each project and handles any required City of Lufkin permits as part of the job.' },
  { q: 'How long does window replacement take for a Lufkin home?', a: 'Most window replacement projects — 8 to 15 windows on a typical Lufkin home — are completed in 1–2 days. Larger homes or those requiring structural modifications to rough openings take longer. We provide a written schedule in every proposal.' },
  { q: 'What are the energy savings from new windows in East Texas?', a: 'New low-E windows with proper solar heat gain coefficients can significantly reduce cooling load in Lufkin\'s long, hot summers. Poorly sealing original single-pane or aged double-pane windows also allow significant air infiltration that strains HVAC systems. The payback is real in Lufkin\'s climate — we can walk through the expected improvement at the estimate.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Window Installation in Lufkin TX',
    provider: { '@type': 'GeneralContractor', '@id': 'https://www.purposeconstructionco.com/#business', name: 'Purpose Construction', url: 'https://www.purposeconstructionco.com/' },
    areaServed: { '@type': 'City', name: 'Lufkin', containedIn: { '@type': 'State', name: 'Texas' } },
    description: 'Window installation and replacement in Lufkin, TX. Energy-efficient vinyl, fiberglass, and wood windows for Angelina County homeowners.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Window Installation in Lufkin, TX | Purpose Construction"
  description="Window installation in Lufkin, TX: low-E replacement windows, flashed and sealed for East Texas heat and rain. Free estimates: (936) 255-2235."
  schema={schema}
>
  <Breadcrumb items={[
    { label: 'Services', href: '/services/' },
    { label: 'Exterior Services', href: '/exterior-services/' },
    { label: 'Window Installation', href: '/window-installation/' },
  ]} />

  <PageHero
    title="Window Installation in Lufkin, TX"
    subtitle="Purpose Construction installs and replaces windows for Lufkin and Angelina County homeowners — properly spec'd for East Texas heat and humidity, properly installed for long-term performance."
    tag="Lufkin, TX"
    image="/images/window-installation-east-texas.jpg"
  />

  <div class="bg-charcoal-900 border-b border-charcoal-700">
    <div class="container-wide px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm font-semibold text-white">Serving Lufkin & Angelina County — Free on-site estimates, no obligation.</p>
      <div class="flex items-center gap-3">
        <a href="tel:9362552235" class="text-sm font-bold text-brand-red hover:text-white transition-colors duration-150">(936) 255-2235</a>
        <a href="/contact/" class="btn-primary py-2.5 text-xs">Get a Free Quote</a>
      </div>
    </div>
  </div>

  <section class="section-padding bg-warm-50">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading tag="Lufkin, TX" title="Windows Spec'd for East Texas Heat" />
          <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
            <p>Window selection for Lufkin homes requires attention to solar heat gain and humidity performance — not just the U-factor that northern climate windows are rated on. East Texas summers put intense UV and heat load on south- and west-facing windows. Purpose Construction's window installation team specifies low-E glass coatings and solar heat gain coefficients appropriate for Angelina County's climate zone, not generic ratings that mean less here than elsewhere.</p>
            <p>We replace windows in existing openings and can modify rough openings for larger or different window configurations. Window replacement is frequently combined with <a href="/siding-installation/" class="text-brand-red hover:underline font-semibold">siding replacement</a> or <a href="/door-installation/" class="text-brand-red hover:underline font-semibold">door installation</a> for a complete exterior envelope upgrade in one coordinated project.</p>
            <p>Most like-for-like window replacements in Lufkin don't require a permit. We handle any required City of Lufkin permits and coordinate with the homeowner's schedule to minimize disruption.</p>
            <p>Window installation is a trade where flashing and sealing details determine whether the product performs for 20 years or starts causing water intrusion within a few seasons. We flash every window opening with a continuous water management system, integrate with the house wrap, and seal interior and exterior properly so the window unit is part of a complete moisture-resistant assembly — not just a glass pane dropped into a hole.</p>
          </div>
          <div class="mt-6 flex gap-4">
            <a href="/contact/" class="btn-primary">Get a Free Estimate</a>
            <a href="tel:9362552235" class="btn-outline">Call (936) 255-2235</a>
          </div>
        </div>
        <div class="space-y-5">
          <img
            src="/images/window-installation-east-texas.jpg"
            alt="Window installation in Lufkin, TX by Purpose Construction"
            class="rounded-xl shadow-hero w-full"
            width="640" height="480"
            loading="lazy" decoding="async"
          />
          <div class="rounded-xl border border-warm-200 bg-white p-5 shadow-card">
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-charcoal-400">Contact Information</p>
            <p class="text-base font-bold text-charcoal-900">Purpose Construction</p>
            <p class="mt-1 text-sm text-charcoal-600">Lufkin, TX 75904</p>
            <a href="tel:9362552235" class="mt-1 block text-sm font-semibold text-brand-red hover:text-brand-red-dark transition-colors duration-150">(936) 255-2235</a>
            <a href="mailto:info@purposeconstructionco.com" class="mt-0.5 block text-sm text-charcoal-500 hover:text-charcoal-800 transition-colors duration-150">info@purposeconstructionco.com</a>
            <div class="mt-3 border-t border-warm-200 pt-3 text-xs text-charcoal-500">
              <p>Mon–Sat: 8:00 AM – 8:00 PM</p>
              <p>Sunday: Closed</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="What We Handle" title="Full-Scope Window Services" align="center" />
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {[
          'Full-House Replacement', 'Single Window Replacement', 'Vinyl Windows',
          'Fiberglass Windows', 'Casement & Double-Hung', 'Bay & Bow Windows',
          'Egress Windows', 'Rough Opening Modification', 'Flashing & Sealing',
          'Interior Trim Finish', 'Low-E Glass Packages', 'Permit Management',
        ].map((item) => (
          <div class="flex items-center gap-2 rounded-lg border border-warm-200 bg-warm-50 px-4 py-3 text-sm font-semibold text-charcoal-700">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-red" aria-hidden="true"></span>
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-warm-100 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Our Process" title="How Window Installation Works in Lufkin" />
      <ol class="space-y-6">
        {[
          { step: '1', title: 'Free On-Site Estimate', body: 'We measure every opening, assess the existing window condition and framing, and discuss style, glass package, and grille options.' },
          { step: '2', title: 'Written Proposal', body: 'Itemized pricing by window, product spec including glass package and SHGC rating, and project schedule.' },
          { step: '3', title: 'Order & Lead Time', body: 'Windows are ordered per spec. Most products have a 2–4 week lead time. We schedule install on confirmed delivery.' },
          { step: '4', title: 'Removal & Framing Check', body: 'Existing windows removed, rough openings inspected for rot, moisture damage, or framing issues before new units go in.' },
          { step: '5', title: 'Installation & Sealing', body: 'New windows set, shimmed plumb and level, flashed, and sealed with weatherization foam and exterior caulk.' },
          { step: '6', title: 'Interior Trim & Final Walkthrough', body: 'Interior trim reinstalled or replaced. All windows tested for operation. Final walkthrough with you before we leave.' },
        ].map((step) => (
          <li class="flex gap-6 items-start">
            <span class="flex-shrink-0 flex h-9 w-9 items-center justify-center rounded-full bg-brand-red text-white font-display font-bold text-sm" aria-hidden="true">{step.step}</span>
            <div>
              <h3 class="display-sm text-charcoal-900 mb-1">{step.title}</h3>
              <p class="text-sm leading-relaxed text-charcoal-500">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Common Questions" title="Window Installation FAQs — Lufkin, TX" align="center" />
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-warm-200 bg-warm-50 shadow-card">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 list-none">
              <h3 class="text-sm font-semibold text-charcoal-800 pr-4">{faq.q}</h3>
              <svg class="h-5 w-5 flex-shrink-0 text-charcoal-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed text-charcoal-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-warm-50 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also in Lufkin" title="Related Services in Lufkin, TX" />
      <div class="flex flex-wrap gap-3">
        {[
          { label: 'Door Installation', href: '/door-installation/' },
          { label: 'Siding Installation', href: '/siding-installation/' },
          { label: 'Exterior Painting', href: '/exterior-painting/' },
          { label: 'All Services', href: '/services/' },
        ].map((link) => (
          <a href={link.href} class="rounded-lg border border-warm-200 bg-white px-5 py-3 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-charcoal-900 transition-all duration-200">
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also Serving" title="Nearby Communities" />
      <div class="flex flex-wrap gap-3">
        <a href="/locations/nacogdoches/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Nacogdoches →</a>
        <a href="/locations/diboll/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Diboll →</a>
        <a href="/locations/huntington/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Huntington →</a>
        <a href="/locations/hudson/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Hudson →</a>
        <a href="/locations/zavalla/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Zavalla →</a>
        <a href="/locations/" class="rounded-lg border border-brand-red/30 bg-brand-red-light px-5 py-2.5 text-sm font-semibold text-brand-red hover:bg-brand-red hover:text-white transition-all duration-200">All Service Areas →</a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-red">
    <div class="container-mid px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="display-md text-white mb-4">Start Your Window Project in Lufkin</h2>
      <p class="mx-auto mb-8 max-w-xl text-base text-white/80">Call us or fill out the contact form for a free on-site estimate. We serve Lufkin, Nacogdoches, Diboll, Huntington, and all of Angelina County.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact/" class="btn-ghost px-8 py-4">Get a Free Quote</a>
        <a href="tel:9362552235" class="text-sm font-semibold text-white/70 hover:text-white transition-colors duration-150">(936) 255-2235</a>
      </div>
    </div>
  </section>
</BaseLayout>
