---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';

const faqs = [
  { q: 'Do you build commercial buildings in Lufkin, TX?', a: 'Yes. Purpose Construction handles ground-up commercial construction, metal building erection, and tenant improvements for businesses in Lufkin and Angelina County. From office suites to warehouses and retail buildouts, we manage the full scope.' },
  { q: 'What types of commercial projects do you handle in Lufkin?', a: 'We build and renovate offices, retail spaces, medical offices, warehouses, storage facilities, and light industrial spaces. We also handle commercial tenant improvements for existing buildings throughout the Lufkin area.' },
  { q: 'How does commercial permitting work in Angelina County?', a: 'Commercial projects in Lufkin require permits through the City of Lufkin Building Inspection Department and must meet IBC (International Building Code) requirements. Projects over certain thresholds require engineered drawings. Purpose Construction manages all permits and engineer coordination.' },
  { q: 'Do you do tenant improvements for existing commercial spaces in Lufkin?', a: 'Yes. Tenant improvements (TI) for existing commercial buildings are a regular part of our work in Lufkin — office renovations, medical build-outs, restaurant conversions, and retail refreshes. We work with landlords and tenants directly.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Commercial Construction in Lufkin TX',
    provider: { '@type': 'GeneralContractor', '@id': 'https://www.purposeconstructionco.com/#business', name: 'Purpose Construction', url: 'https://www.purposeconstructionco.com/' },
    areaServed: { '@type': 'City', name: 'Lufkin', containedInPlace: { '@type': 'State', name: 'Texas' } },
    description: 'Commercial construction and tenant improvements in Lufkin, TX. Purpose Construction builds offices, retail spaces, warehouses, and medical facilities across Angelina County.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Commercial Construction in Lufkin, TX | Purpose Construction"
  description="Commercial construction in Lufkin, TX: offices, retail, warehouses and tenant buildouts across Angelina County. Free estimates: (936) 255-2235."
  schema={schema}
>
  <Breadcrumb items={[
    { label: 'Services', href: '/services/' },
    { label: 'New Construction', href: '/new-construction/' },
    { label: 'Commercial Construction', href: '/commercial-construction/' },
  ]} />

  <PageHero
    title="Commercial Construction in Lufkin, TX"
    subtitle="Purpose Construction builds and renovates commercial spaces across Lufkin and Angelina County — offices, retail, warehouses, and medical facilities. Insured, full-scope."
    tag="Lufkin, TX"
    image="/images/commercial-construction-east-texas.jpg"
  />

  <div class="bg-charcoal-900 border-b border-charcoal-700">
    <div class="container-wide px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm font-semibold text-white">Serving Lufkin & Angelina County — Free on-site estimates, no obligation.</p>
      <div class="flex items-center gap-3">
        <a href="tel:9362552235" class="text-sm font-bold text-brand-red hover:text-white transition-colors duration-150">(936) 255-2235</a>
        <a href="/contact/" class="btn-primary py-2.5 text-xs">Get a Free Quote</a>
      </div>
    </div>
  </div>

  <section class="section-padding bg-warm-50">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading tag="Lufkin, TX" title="Commercial Construction for Lufkin Businesses" />
          <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
            <p>Lufkin is the commercial and retail hub of deep East Texas, and consistent demand for new commercial construction along Loop 287 and the city's major corridors reflects that role. Purpose Construction handles commercial construction for businesses establishing or expanding in the Lufkin market — from ground-up builds to tenant improvements in existing spaces.</p>
            <p>Our commercial work spans offices, retail spaces, medical facilities, light industrial, and warehouse construction. We also do <a href="/residential-construction/" class="text-brand-red hover:underline font-semibold">residential construction</a> and can manage mixed-use projects. Every commercial build is fully permitted through the City of Lufkin and meets applicable IBC code requirements.</p>
            <p>We work directly with business owners, property managers, and commercial landlords. Written contracts, engineered drawings where required, and transparent timelines on every project.</p>
            <p>We understand that commercial projects have hard deadlines — lease commencement dates, investor milestones, and business timelines that don't flex. Purpose Construction builds detailed schedules and manages subcontractors to hit them. Whether you're building a warehouse, outfitting a retail space, or constructing an office building, we track every phase and communicate proactively.</p>
          </div>
          <div class="mt-6 flex gap-4">
            <a href="/contact/" class="btn-primary">Get a Free Estimate</a>
            <a href="tel:9362552235" class="btn-outline">Call (936) 255-2235</a>
          </div>
        </div>
        <div class="space-y-5">
          <img
            src="/images/commercial-construction-east-texas.jpg"
            alt="Commercial construction in Lufkin, TX by Purpose Construction"
            class="rounded-xl shadow-hero w-full"
            width="640" height="480"
            loading="lazy" decoding="async"
          />
          <div class="rounded-xl border border-warm-200 bg-white p-5 shadow-card">
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-charcoal-400">Contact Information</p>
            <p class="text-base font-bold text-charcoal-900">Purpose Construction</p>
            <p class="mt-1 text-sm text-charcoal-600">Lufkin, TX · serving East Texas</p>
            <a href="tel:9362552235" class="mt-1 block text-sm font-semibold text-brand-red hover:text-brand-red-dark transition-colors duration-150">(936) 255-2235</a>
            <a href="mailto:info@purposeconstructionco.com" class="mt-0.5 block text-sm text-charcoal-500 hover:text-charcoal-800 transition-colors duration-150">info@purposeconstructionco.com</a>
            <div class="mt-3 border-t border-warm-200 pt-3 text-xs text-charcoal-500">
              <p>Mon–Sat: 8:00 AM – 6:00 PM</p>
              <p>Sunday: Closed</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="What We Handle" title="Full-Scope Commercial Construction Services" align="center" />
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {[
          'Ground-Up Commercial Builds', 'Tenant Improvements', 'Metal Building Construction',
          'Office Build-Outs', 'Retail Construction', 'Medical Office Buildout',
          'Warehouse & Storage', 'Site Work & Utilities', 'ADA Compliance',
          'Electrical & Data Rough-In', 'Plumbing Systems', 'Permit Management',
        ].map((item) => (
          <div class="flex items-center gap-2 rounded-lg border border-warm-200 bg-warm-50 px-4 py-3 text-sm font-semibold text-charcoal-700">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-red" aria-hidden="true"></span>
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-warm-100 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Our Process" title="How Commercial Construction Works in Lufkin" />
      <ol class="space-y-6">
        {[
          { step: '1', title: 'Free Consultation', body: 'We discuss your commercial project scope, site, budget, and timeline. We work with business owners, tenants, and landlords.' },
          { step: '2', title: 'Written Proposal', body: 'Detailed scope, itemized pricing, engineering requirements, and a project schedule — before any work begins.' },
          { step: '3', title: 'Permits & Pre-Construction', body: 'City of Lufkin commercial permits pulled, engineered drawings coordinated, and all subcontractors scheduled.' },
          { step: '4', title: 'Site Work & Foundation', body: 'Site is prepared, utilities stubbed in, and foundation or slab completed and inspected.' },
          { step: '5', title: 'Structural, Systems & Finishes', body: 'Structure erected, all mechanical systems roughed in and inspected. Interior finishes, storefront, and exterior work completed.' },
          { step: '6', title: 'Final Inspection & Turnover', body: 'Final inspection passed, punch list completed, and space turned over for tenant or owner occupancy.' },
        ].map((step) => (
          <li class="flex gap-6 items-start">
            <span class="flex-shrink-0 flex h-9 w-9 items-center justify-center rounded-full bg-brand-red text-white font-display font-bold text-sm" aria-hidden="true">{step.step}</span>
            <div>
              <h3 class="display-sm text-charcoal-900 mb-1">{step.title}</h3>
              <p class="text-sm leading-relaxed text-charcoal-500">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Common Questions" title="Commercial Construction FAQs — Lufkin, TX" align="center" />
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-warm-200 bg-warm-50 shadow-card">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 list-none">
              <h3 class="text-sm font-semibold text-charcoal-800 pr-4">{faq.q}</h3>
              <svg class="h-5 w-5 flex-shrink-0 text-charcoal-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed text-charcoal-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-warm-50 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also in Lufkin" title="Related Services in Lufkin, TX" />
      <div class="flex flex-wrap gap-3">
        {[
          { label: 'New Construction', href: '/new-construction/' },
          { label: 'Residential Construction', href: '/residential-construction/' },
          { label: 'Barndominium Construction', href: '/barndominium-construction/' },
          { label: 'General Contractor', href: '/' },
        ].map((link) => (
          <a href={link.href} class="rounded-lg border border-warm-200 bg-white px-5 py-3 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-charcoal-900 transition-all duration-200">
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also Serving" title="Nearby Communities" />
      <div class="flex flex-wrap gap-3">
        <a href="/locations/nacogdoches/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Nacogdoches →</a>
        <a href="/locations/diboll/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Diboll →</a>
        <a href="/locations/huntington/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Huntington →</a>
        <a href="/locations/hudson/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Hudson →</a>
        <a href="/locations/zavalla/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Zavalla →</a>
        <a href="/locations/" class="rounded-lg border border-brand-red/30 bg-brand-red-light px-5 py-2.5 text-sm font-semibold text-brand-red hover:bg-brand-red hover:text-white transition-all duration-200">All Service Areas →</a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-red">
    <div class="container-mid px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="display-md text-white mb-4">Start Your Commercial Project in Lufkin</h2>
      <p class="mx-auto mb-8 max-w-xl text-base text-white/80">Call us or fill out the contact form for a free consultation. We serve Lufkin businesses and properties throughout Angelina County.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact/" class="btn-ghost px-8 py-4">Get a Free Quote</a>
        <a href="tel:9362552235" class="text-sm font-semibold text-white/70 hover:text-white transition-colors duration-150">(936) 255-2235</a>
      </div>
    </div>
  </section>
</BaseLayout>
