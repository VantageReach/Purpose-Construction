---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';

const faqs = [
  { q: 'What\'s the difference between a pergola and a pavilion?', a: 'A pergola has an open lattice or slatted roof that provides partial shade and visual structure. A pavilion has a fully solid roof that provides complete weather protection. For Lufkin\'s hot summers, many homeowners choose a pavilion for full shade, or add a shade canopy system to a pergola.' },
  { q: 'Do I need a permit for a pergola in Angelina County?', a: 'Attached pergolas in Lufkin typically require a permit. Freestanding pergolas may not, depending on size. Purpose Construction assesses each project and handles all required City of Lufkin permits as part of the job.' },
  { q: 'What materials are best for a pergola in East Texas humidity?', a: 'Cedar and pressure-treated lumber perform well if properly sealed and maintained. Aluminum and powder-coated steel pergolas are the most durable against East Texas humidity and UV — they don\'t warp, rot, or require annual refinishing. We discuss the tradeoffs for each material at the estimate.' },
  { q: 'How long does pergola construction take?', a: 'A standard freestanding or attached pergola in Lufkin takes approximately 1–2 weeks from permit approval to completion. Larger pavilion structures with roofing systems take 2–4 weeks.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Pergola Construction in Lufkin TX',
    provider: { '@type': 'GeneralContractor', name: 'Purpose Construction', url: 'https://www.purposeconstructionco.com' },
    areaServed: { '@type': 'City', name: 'Lufkin', containedIn: { '@type': 'State', name: 'Texas' } },
    description: 'Pergola construction in Lufkin, TX. Freestanding and attached pergolas, pavilions, and shade structures for Angelina County homeowners.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Pergola Construction in Lufkin, TX | Purpose Construction"
  description="Pergola construction in Lufkin, TX: cedar, pressure-treated and louvered pergolas, wired for fans and lights. Free estimates: (936) 255-2235."
  schema={schema}
>
  <Breadcrumb items={[
    { label: 'Services', href: '/services' },
    { label: 'Outdoor Living', href: '/outdoor-living' },
    { label: 'Pergola Construction', href: '/pergola-construction' },
  ]} />

  <PageHero
    title="Pergola Construction in Lufkin, TX"
    subtitle="Purpose Construction builds pergolas and shade structures for Lufkin and Angelina County homeowners — designed for East Texas summer heat and built to last."
    tag="Lufkin, TX"
    image="/images/pergola-construction-east-texas.jpg"
  />

  <div class="bg-charcoal-900 border-b border-charcoal-700">
    <div class="container-wide px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm font-semibold text-white">Serving Lufkin & Angelina County — Free on-site estimates, no obligation.</p>
      <div class="flex items-center gap-3">
        <a href="tel:9362552235" class="text-sm font-bold text-brand-red hover:text-white transition-colors duration-150">(936) 255-2235</a>
        <a href="/contact" class="btn-primary py-2.5 text-xs">Get a Free Quote</a>
      </div>
    </div>
  </div>

  <section class="section-padding bg-warm-50">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading tag="Lufkin, TX" title="Pergolas & Shade Structures for East Texas Homes" />
          <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
            <p>A pergola transforms a patio or deck into a defined outdoor living space — adding visual structure, shade, and character to what would otherwise be an open slab. In Lufkin's summer heat, shade matters. Purpose Construction builds pergolas that are designed for East Texas conditions: properly footed to handle wind loads, built from materials that resist humidity, and proportioned to match your home's architecture.</p>
            <p>We build freestanding and attached pergolas in cedar, pressure-treated lumber, and aluminum. Pergolas are commonly paired with a <a href="/patio-construction" class="text-brand-red hover:underline font-semibold">patio</a> or <a href="/deck-construction" class="text-brand-red hover:underline font-semibold">deck</a> as part of a complete <a href="/outdoor-living" class="text-brand-red hover:underline font-semibold">outdoor living</a> project — we plan and build all of it as one coordinated job.</p>
            <p>We build in cedar, which resists moisture and insects naturally and weathers beautifully in the Piney Woods climate, as well as pressure-treated pine and composite materials for different budget points and maintenance preferences. Louvered pergolas — with adjustable roof panels that open and close — are increasingly popular with East Texas homeowners who want shade control without committing to a fully roofed pavilion structure.</p>
            <p>We wire pergolas for ceiling fans and lighting during construction, so your outdoor space is functional from day one. We also integrate pergolas with new deck builds, existing patios, and pool decks throughout Lufkin and Angelina County.</p>
          </div>
          <div class="mt-6 flex gap-4">
            <a href="/contact" class="btn-primary">Get a Free Estimate</a>
            <a href="tel:9362552235" class="btn-outline">Call (936) 255-2235</a>
          </div>
        </div>
        <div class="space-y-5">
          <img
            src="/images/pergola-construction-east-texas.jpg"
            alt="Pergola construction in Lufkin, TX by Purpose Construction"
            class="rounded-xl shadow-hero w-full"
            width="640" height="480"
            loading="lazy" decoding="async"
          />
          <div class="rounded-xl border border-warm-200 bg-white p-5 shadow-card">
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-charcoal-400">Contact Information</p>
            <p class="text-base font-bold text-charcoal-900">Purpose Construction</p>
            <p class="mt-1 text-sm text-charcoal-600">Lufkin, TX 75904</p>
            <a href="tel:9362552235" class="mt-1 block text-sm font-semibold text-brand-red hover:text-brand-red-dark transition-colors duration-150">(936) 255-2235</a>
            <a href="mailto:info@purposeconstructionco.com" class="mt-0.5 block text-sm text-charcoal-500 hover:text-charcoal-800 transition-colors duration-150">info@purposeconstructionco.com</a>
            <div class="mt-3 border-t border-warm-200 pt-3 text-xs text-charcoal-500">
              <p>Mon–Sat: 8:00 AM – 8:00 PM</p>
              <p>Sunday: Closed</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="What We Handle" title="Pergola & Shade Structure Services" align="center" />
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {[
          'Freestanding Pergolas', 'Attached Pergolas', 'Cedar Pergolas',
          'Aluminum Pergolas', 'Pavilion Construction', 'Shade Canopy Systems',
          'Lighting Integration', 'Fan Mounts', 'Decorative Trim',
          'Stain & Finish', 'Post Footings', 'Permit Management',
        ].map((item) => (
          <div class="flex items-center gap-2 rounded-lg border border-warm-200 bg-warm-50 px-4 py-3 text-sm font-semibold text-charcoal-700">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-red" aria-hidden="true"></span>
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-warm-100 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Our Process" title="How Pergola Construction Works in Lufkin" />
      <ol class="space-y-6">
        {[
          { step: '1', title: 'Free On-Site Estimate', body: 'We assess your yard, patio, or deck, discuss size, style, and material options, and provide a written quote.' },
          { step: '2', title: 'Written Proposal', body: 'Detailed scope with material selection, footings plan, connection method, and project timeline.' },
          { step: '3', title: 'Permit & Planning', body: 'We assess permit requirements and pull any needed City of Lufkin permits before any footings are dug.' },
          { step: '4', title: 'Post Setting & Foundation', body: 'Post holes are dug to proper depth, concrete footings poured, and posts set plumb and level.' },
          { step: '5', title: 'Beam & Rafter Installation', body: 'Beams, rafters, and any lattice or canopy elements are installed. Lighting conduit and fan blocking added as specified.' },
          { step: '6', title: 'Finish & Final Walkthrough', body: 'Stain or paint applied, all hardware checked, and the structure is inspected with you before we leave.' },
        ].map((step) => (
          <li class="flex gap-6 items-start">
            <span class="flex-shrink-0 flex h-9 w-9 items-center justify-center rounded-full bg-brand-red text-white font-display font-bold text-sm" aria-hidden="true">{step.step}</span>
            <div>
              <h3 class="display-sm text-charcoal-900 mb-1">{step.title}</h3>
              <p class="text-sm leading-relaxed text-charcoal-500">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Common Questions" title="Pergola FAQs — Lufkin, TX" align="center" />
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-warm-200 bg-warm-50 shadow-card">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 list-none">
              <h3 class="text-sm font-semibold text-charcoal-800 pr-4">{faq.q}</h3>
              <svg class="h-5 w-5 flex-shrink-0 text-charcoal-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed text-charcoal-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-warm-50 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also in Lufkin" title="Related Services in Lufkin, TX" />
      <div class="flex flex-wrap gap-3">
        {[
          { label: 'Patio Construction', href: '/patio-construction' },
          { label: 'Deck Construction', href: '/deck-construction' },
          { label: 'Outdoor Living', href: '/outdoor-living' },
          { label: 'All Services', href: '/services' },
        ].map((link) => (
          <a href={link.href} class="rounded-lg border border-warm-200 bg-white px-5 py-3 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-charcoal-900 transition-all duration-200">
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also Serving" title="Nearby Communities" />
      <div class="flex flex-wrap gap-3">
        <a href="/locations/nacogdoches" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Nacogdoches →</a>
        <a href="/locations/diboll" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Diboll →</a>
        <a href="/locations/huntington" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Huntington →</a>
        <a href="/locations/hudson" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Hudson →</a>
        <a href="/locations/zavalla" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Zavalla →</a>
        <a href="/locations" class="rounded-lg border border-brand-red/30 bg-brand-red-light px-5 py-2.5 text-sm font-semibold text-brand-red hover:bg-brand-red hover:text-white transition-all duration-200">All Service Areas →</a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-red">
    <div class="container-mid px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="display-md text-white mb-4">Start Your Pergola Project in Lufkin</h2>
      <p class="mx-auto mb-8 max-w-xl text-base text-white/80">Call us or fill out the contact form for a free on-site estimate. We serve Lufkin, Nacogdoches, Diboll, Huntington, and all of Angelina County.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact" class="btn-ghost px-8 py-4">Get a Free Quote</a>
        <a href="tel:9362552235" class="text-sm font-semibold text-white/70 hover:text-white transition-colors duration-150">(936) 255-2235</a>
      </div>
    </div>
  </section>
</BaseLayout>
