---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';

const faqs = [
  { q: 'What outdoor structures work best in East Texas heat?', a: 'Covered structures — pergolas, pavilions, and covered patios — provide the most usable outdoor space in Lufkin\'s climate. Adding a ceiling fan and proper ventilation extends usability through the summer months. We design for East Texas conditions, not a national template.' },
  { q: 'How long does outdoor living construction take?', a: 'A concrete patio takes 1–2 weeks. A deck or pergola typically runs 2–4 weeks. A more elaborate outdoor kitchen or pavilion setup can take 4–8 weeks. We provide a written timeline in every proposal.' },
  { q: 'What materials hold up best in Lufkin\'s climate?', a: 'Concrete, pavers, composite decking, pressure-treated lumber, and aluminum or steel pergola structures all perform well in East Texas humidity and UV exposure. We recommend against untreated wood in exposed applications and will discuss material tradeoffs during your estimate.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Outdoor Living in Lufkin TX',
    provider: { '@type': 'GeneralContractor', name: 'Purpose Construction', url: 'https://www.purposeconstructionco.com' },
    areaServed: { '@type': 'City', name: 'Lufkin', containedIn: { '@type': 'State', name: 'Texas' } },
    description: 'Outdoor living construction in Lufkin, TX. Patios, decks, pergolas, pavilions, and outdoor kitchens for Angelina County homeowners.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
const services = [
  { title: 'Patio Construction', body: 'Poured concrete, stamped concrete, pavers, and flagstone patios designed for East Texas outdoor entertaining.', href: '/patio-construction' },
  { title: 'Deck Construction', body: 'Pressure-treated, composite, and hardwood decks that stand up to East Texas heat and humidity.', href: '/deck-construction' },
  { title: 'Pergola Construction', body: 'Custom pergolas for shade and style — freestanding or attached to your home, any size.', href: '/pergola-construction' },
  { title: 'Pavilion Construction', body: 'Fully covered pavilions with roofing, lighting options, and optional screens for year-round outdoor living.', href: '/pavilion-construction' },
  { title: 'Fence Installation', body: 'Wood, vinyl, chain link, and ornamental iron fencing for privacy, security, and curb appeal.', href: '/fence-installation' },
  { title: 'Driveway Installation', body: 'Concrete and asphalt driveways installed and finished with proper drainage for East Texas soil conditions.', href: '/driveway-installation' },
  { title: 'Walkway Installation', body: 'Poured concrete, paver, and flagstone walkways connecting your home, garage, and outdoor spaces.', href: '/walkway-installation' },
];
---

<BaseLayout
  title="Outdoor Living in Lufkin, TX | Purpose Construction"
  description="Outdoor living in Lufkin, TX: patios, decks, pergolas, pavilions, fences and driveways built for East Texas heat. Free estimates: (936) 255-2235."
  schema={schema}
>
  <Breadcrumb items={[
    { label: 'Services', href: '/services' },
    { label: 'Outdoor Living', href: '/outdoor-living' },
  ]} />

  <PageHero
    title="Outdoor Living in Lufkin, TX"
    subtitle="Purpose Construction builds outdoor living spaces for Lufkin and Angelina County homeowners — patios, decks, pergolas, and covered structures designed for East Texas conditions."
    tag="Lufkin, TX"
    image="/images/outdoor-living-east-texas.jpg"
  />

  <div class="bg-charcoal-900 border-b border-charcoal-700">
    <div class="container-wide px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm font-semibold text-white">Serving Lufkin & Angelina County — Free on-site estimates, no obligation.</p>
      <div class="flex items-center gap-3">
        <a href="tel:9362552235" class="text-sm font-bold text-brand-red hover:text-white transition-colors duration-150">(936) 255-2235</a>
        <a href="/contact" class="btn-primary py-2.5 text-xs">Get a Free Quote</a>
      </div>
    </div>
  </div>

  <section class="section-padding bg-warm-50">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading tag="Lufkin, TX" title="Outdoor Living Built for East Texas" />
          <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
            <p>East Texas has one of the longest outdoor living seasons in the country — Lufkin homeowners can enjoy their yards from March through November with the right setup. Purpose Construction builds outdoor living spaces that are designed for Angelina County's wooded lots, humid climate, and hot summers — not a generic national template.</p>
            <p>We build everything from a simple concrete patio to a fully covered outdoor kitchen and living area. Projects are often layered: a <a href="/patio-construction" class="text-brand-red hover:underline font-semibold">patio or deck</a> as the base, topped with a <a href="/pergola-construction" class="text-brand-red hover:underline font-semibold">pergola or pavilion</a> for shade and definition. We design and build it as a unified project.</p>
            <p>East Texas summers are long and hot. Pine roots are aggressive. Humidity causes untreated wood to rot in just a few seasons. Our outdoor construction uses materials and methods proven in this specific climate.</p>
          </div>
          <div class="mt-6 flex gap-4">
            <a href="/contact" class="btn-primary">Get a Free Estimate</a>
            <a href="tel:9362552235" class="btn-outline">Call (936) 255-2235</a>
          </div>
        </div>
        <div class="space-y-5">
          <img
            src="/images/outdoor-living-east-texas.jpg"
            alt="Outdoor living construction in Lufkin, TX by Purpose Construction"
            class="rounded-xl shadow-hero w-full"
            width="640" height="480"
            loading="lazy" decoding="async"
          />
          <div class="rounded-xl border border-warm-200 bg-white p-5 shadow-card">
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-charcoal-400">Contact Information</p>
            <p class="text-base font-bold text-charcoal-900">Purpose Construction</p>
            <p class="mt-1 text-sm text-charcoal-600">Lufkin, TX 75904</p>
            <a href="tel:9362552235" class="mt-1 block text-sm font-semibold text-brand-red hover:text-brand-red-dark transition-colors duration-150">(936) 255-2235</a>
            <a href="mailto:info@purposeconstructionco.com" class="mt-0.5 block text-sm text-charcoal-500 hover:text-charcoal-800 transition-colors duration-150">info@purposeconstructionco.com</a>
            <div class="mt-3 border-t border-warm-200 pt-3 text-xs text-charcoal-500">
              <p>Mon–Sat: 8:00 AM – 8:00 PM</p>
              <p>Sunday: Closed</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-padding bg-warm-50">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading
        tag="Outdoor Services"
        title="Your Backyard, Built Right"
        subtitle="East Texas has the land and the weather for serious outdoor living. We build spaces that handle heat, humidity, and heavy use — year after year."
      />
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((svc) => (
          <a
            href={svc.href}
            class="group relative rounded-xl border border-warm-200 bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover hover:border-brand-red-mid"
          >
            <h2 class="display-sm mb-2 text-charcoal-900">{svc.title}</h2>
            <p class="text-sm leading-relaxed text-charcoal-500">{svc.body}</p>
            <span class="service-link mt-4 inline-flex">
              Learn more
              <svg class="h-4 w-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="What We Handle" title="Outdoor Living Services in Lufkin" align="center" />
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {[
          'Patio Construction', 'Deck Building', 'Pergola Construction',
          'Pavilion Construction', 'Outdoor Kitchens', 'Fire Pit Areas',
          'Retaining Walls', 'Landscaping Prep', 'Outdoor Lighting',
          'Concrete Work', 'Wood & Composite Structures',
        ].map((item) => (
          <div class="flex items-center gap-2 rounded-lg border border-warm-200 bg-warm-50 px-4 py-3 text-sm font-semibold text-charcoal-700">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-red" aria-hidden="true"></span>
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-warm-100 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Our Process" title="How Outdoor Living Projects Work in Lufkin" />
      <ol class="space-y-6">
        {[
          { step: '1', title: 'Free On-Site Consultation', body: 'We visit your Lufkin property, assess your yard, sun exposure, and goals, and discuss material and layout options.' },
          { step: '2', title: 'Written Proposal', body: 'Detailed scope with itemized pricing, material selections, and a project schedule.' },
          { step: '3', title: 'Planning', body: 'We lay out the space, confirm materials and schedule the work before any ground is disturbed.' },
          { step: '4', title: 'Site Prep & Foundation Work', body: 'Area is graded and prepped. Footings or concrete slab is formed, poured, and cured.' },
          { step: '5', title: 'Structure & Finishes', body: 'Framing, decking, pergola or roofing structure, lighting, and all detail work completed to spec.' },
          { step: '6', title: 'Final Walkthrough', body: 'We walk the completed project with you, ensure everything is right, and leave the space ready to enjoy.' },
        ].map((step) => (
          <li class="flex gap-6 items-start">
            <span class="flex-shrink-0 flex h-9 w-9 items-center justify-center rounded-full bg-brand-red text-white font-display font-bold text-sm" aria-hidden="true">{step.step}</span>
            <div>
              <h3 class="display-sm text-charcoal-900 mb-1">{step.title}</h3>
              <p class="text-sm leading-relaxed text-charcoal-500">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Common Questions" title="Outdoor Living FAQs — Lufkin, TX" align="center" />
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-warm-200 bg-warm-50 shadow-card">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 list-none">
              <h3 class="text-sm font-semibold text-charcoal-800 pr-4">{faq.q}</h3>
              <svg class="h-5 w-5 flex-shrink-0 text-charcoal-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed text-charcoal-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-warm-50 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also in Lufkin" title="Related Services in Lufkin, TX" />
      <div class="flex flex-wrap gap-3">
        {[
          { label: 'Patio Construction', href: '/patio-construction' },
          { label: 'Deck Construction', href: '/deck-construction' },
          { label: 'Pergola Construction', href: '/pergola-construction' },
          { label: 'Exterior Painting', href: '/exterior-painting' },
          { label: 'All Services', href: '/services' },
        ].map((link) => (
          <a href={link.href} class="rounded-lg border border-warm-200 bg-white px-5 py-3 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-charcoal-900 transition-all duration-200">
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also Serving" title="Nearby Communities" />
      <div class="flex flex-wrap gap-3">
        <a href="/locations/nacogdoches" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Nacogdoches →</a>
        <a href="/locations/diboll" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Diboll →</a>
        <a href="/locations/huntington" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Huntington →</a>
        <a href="/locations/hudson" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Hudson →</a>
        <a href="/locations/zavalla" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Zavalla →</a>
        <a href="/locations" class="rounded-lg border border-brand-red/30 bg-brand-red-light px-5 py-2.5 text-sm font-semibold text-brand-red hover:bg-brand-red hover:text-white transition-all duration-200">All Service Areas →</a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-red">
    <div class="container-mid px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="display-md text-white mb-4">Start Your Outdoor Living Project in Lufkin</h2>
      <p class="mx-auto mb-8 max-w-xl text-base text-white/80">Call us or fill out the contact form for a free on-site estimate. We serve Lufkin, Nacogdoches, Diboll, Huntington, and all of Angelina County.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact" class="btn-ghost px-8 py-4">Get a Free Quote</a>
        <a href="tel:9362552235" class="text-sm font-semibold text-white/70 hover:text-white transition-colors duration-150">(936) 255-2235</a>
      </div>
    </div>
  </section>
</BaseLayout>
