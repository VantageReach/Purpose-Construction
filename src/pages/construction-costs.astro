---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';

const prices = [
  {
    job: 'Kitchen remodel',
    href: '/kitchen-remodeling/',
    rows: [
      { scope: 'Refresh: new cabinets, countertops and appliances', range: '$20,000 to $40,000' },
      { scope: 'Full gut renovation with layout changes', range: '$40,000 to $80,000+' },
    ],
    moves: 'Moving plumbing or walls, cabinet grade and countertop material.',
  },
  {
    job: 'Bathroom remodel',
    href: '/bathroom-remodeling/',
    rows: [
      { scope: 'Refresh: new vanity, fixtures and flooring', range: '$6,000 to $15,000' },
      { scope: 'Custom tile shower with new plumbing or layout', range: '$15,000 to $35,000+' },
    ],
    moves: 'Tile work, moving the drain or tub, and what we find behind the old walls.',
  },
  {
    job: 'Barndominium',
    href: '/barndominium-construction/',
    rows: [
      { scope: 'Finished living space in Angelina County', range: '$90 to $175 per sq ft' },
    ],
    moves: 'Finish level, overall size, and how much work the land needs first.',
  },
  {
    job: 'New custom home',
    href: '/residential-construction/',
    rows: [
      { scope: 'Built on your lot in the Lufkin area', range: '$150 to $250 per sq ft' },
    ],
    moves: 'Finish level, site conditions and how complex the plan is.',
  },
  {
    job: 'Deck',
    href: '/deck-construction/',
    rows: [
      { scope: 'Pressure-treated wood, installed', range: '$25 to $40 per sq ft' },
      { scope: 'Composite decking, installed', range: '$45 to $75+ per sq ft' },
    ],
    moves: 'The decking brand and the railing system you pick.',
  },
  {
    job: 'Concrete patio',
    href: '/patio-construction/',
    rows: [
      { scope: 'Standard broom finish, installed', range: '$8 to $12 per sq ft' },
      { scope: 'Stamped or decorative concrete', range: '$15 to $25+ per sq ft' },
    ],
    moves: 'How busy the stamp pattern is and how much grading the yard needs.',
  },
];

const faqs = [
  { q: 'How much does a kitchen remodel cost in Lufkin, TX?', a: 'A refresh with new cabinets, countertops and appliances usually runs $20,000 to $40,000 in the Lufkin area. A full gut renovation with layout changes runs $40,000 to $80,000 and up. Your number comes from a free on-site estimate.' },
  { q: 'What does a barndominium cost per square foot in East Texas?', a: 'In Angelina County, finished living space in a barndominium typically runs $90 to $175 per square foot. Finish level, size and site conditions decide where you land in that range.' },
  { q: 'How much does it cost to build a new home in Lufkin?', a: 'New custom homes in the Lufkin area typically run $150 to $250 per square foot, depending on finish level, site conditions and how complex the plan is.' },
  { q: 'Why are the price ranges so wide?', a: 'Because two jobs with the same name can be very different. Moving a sink across the room means new plumbing. A slab on a sloped lot needs dirt work first. We price your job after we see it, and the written proposal is the number we hold to.' },
  { q: 'Do you charge for an estimate?', a: 'No. We come out, walk the project with you and give you a written estimate at no cost and with no obligation.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://www.purposeconstructionco.com/construction-costs/#webpage',
    name: 'Construction Costs in Lufkin, TX',
    url: 'https://www.purposeconstructionco.com/construction-costs/',
    description: 'Typical price ranges for kitchen and bath remodels, barndominiums, new homes, decks and patios in Lufkin and Angelina County, TX.',
    about: { '@id': 'https://www.purposeconstructionco.com/#business' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Construction Costs in Lufkin, TX | Purpose Construction"
  description="What remodels, barndominiums, new homes, decks and patios cost in Lufkin, TX. Real price ranges from a local contractor. Call (936) 255-2235."
  schema={schema}
>
  <Breadcrumb items={[
    { label: 'Services', href: '/services/' },
    { label: 'Construction Costs', href: '/construction-costs/' },
  ]} />

  <PageHero
    title="Construction Costs in Lufkin, TX"
    subtitle="Price ranges for the work we do most around Lufkin and Angelina County, so you know roughly where you stand before you call."
    tag="Pricing"
    image="/images/construction-company-lufkin-tx.jpg"
  />

  <div class="bg-charcoal-900 border-b border-charcoal-700">
    <div class="container-wide px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm font-semibold text-white">Want your real number? Free on-site estimates, no obligation.</p>
      <div class="flex items-center gap-3">
        <a href="tel:9362552235" class="text-sm font-bold text-brand-red hover:text-white transition-colors duration-150">(936) 255-2235</a>
        <a href="/contact/" class="btn-primary py-2.5 text-xs">Get a Free Quote</a>
      </div>
    </div>
  </div>

  <section class="section-padding bg-warm-50">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Lufkin, TX" title="What Construction Costs Around Lufkin" />
      <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
        <p>People call a construction company in Lufkin wanting a ballpark before anyone drives out. Fair enough. These are the ranges we use for the jobs we do most, from kitchen and bath remodels to barndominiums and new homes.</p>
        <p>They're ranges, not quotes. Your price depends on the size of the job, the finishes you pick and what the house or the land needs before we start. We give you that number in writing after a free on-site estimate, and we stick to it.</p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Price Ranges" title="Typical Prices by Job in Angelina County" />
      <div class="space-y-6">
        {prices.map((p) => (
          <div class="rounded-xl border border-warm-200 bg-warm-50 p-6 shadow-card">
            <h3 class="display-sm text-charcoal-900 mb-3"><a href={p.href} class="hover:text-brand-red focus-visible:text-brand-red transition-colors duration-150">{p.job} cost</a></h3>
            <dl class="divide-y divide-warm-200">
              {p.rows.map((r) => (
                <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <dt class="text-sm text-charcoal-600">{r.scope}</dt>
                  <dd class="text-base font-bold text-charcoal-900 sm:text-right sm:whitespace-nowrap">{r.range}</dd>
                </div>
              ))}
            </dl>
            <p class="mt-3 text-sm text-charcoal-500"><strong class="text-charcoal-700">What moves the price:</strong> {p.moves}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-warm-100 border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Everything Else" title="Jobs We Price After We See Them" />
      <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
        <p>Some work doesn't fit a per-foot number. <a href="/home-additions/" class="text-brand-red hover:underline font-semibold">Home additions</a>, <a href="/metal-structures/" class="text-brand-red hover:underline font-semibold">metal buildings</a>, <a href="/pole-barn-construction/" class="text-brand-red hover:underline font-semibold">pole barns</a>, siding, painting and drywall all depend too much on the building in front of us.</p>
        <p>Call us, tell us what you've got in mind, and we'll come look. You get a written proposal that spells out the scope, and we pull the permits the job needs.</p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Common Questions" title="Construction Cost FAQs, Lufkin TX" align="center" />
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-warm-200 bg-warm-50 shadow-card">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 list-none">
              <h3 class="text-sm font-semibold text-charcoal-800 pr-4">{faq.q}</h3>
              <svg class="h-5 w-5 flex-shrink-0 text-charcoal-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed text-charcoal-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-warm-50 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Services" title="Our Services in Lufkin, TX" />
      <div class="flex flex-wrap gap-3">
        {[
          { label: 'Construction Company in Lufkin', href: '/' },
          { label: 'Remodeling Contractor', href: '/remodeling-contractor/' },
          { label: 'New Construction', href: '/new-construction/' },
          { label: 'Outdoor Living', href: '/outdoor-living/' },
          { label: 'All Services', href: '/services/' },
        ].map((link) => (
          <a href={link.href} class="rounded-lg border border-warm-200 bg-white px-5 py-3 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-charcoal-900 transition-all duration-200">
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-red">
    <div class="container-mid px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="display-md text-white mb-4">Get Your Number in Writing</h2>
      <p class="mx-auto mb-8 max-w-xl text-base text-white/80">Call or send the contact form. We'll come out, walk the job with you and put the price on paper.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact/" class="btn-ghost px-8 py-4">Get a Free Quote</a>
        <a href="tel:9362552235" class="text-sm font-semibold text-white/70 hover:text-white transition-colors duration-150">(936) 255-2235</a>
      </div>
    </div>
  </section>
</BaseLayout>
