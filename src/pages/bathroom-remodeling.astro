---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';

const faqs = [
  { q: 'How long does a bathroom remodel take in Lufkin, TX?', a: 'A standard bathroom remodel in Lufkin typically takes 2 to 4 weeks. A full primary suite renovation or custom tile shower build can run 4 to 6 weeks. We provide a written timeline in every proposal before work begins.' },
  { q: 'Do I need a permit for a bathroom remodel in Angelina County?', a: 'Inside Lufkin city limits, yes: the city requires a building permit for any construction, and we pull it through Lufkin Inspection Services as part of the job. Angelina County has no general building permit outside city limits, so a rural remodel usually doesn\'t need one.' },
  { q: 'Can you remodel a small bathroom?', a: 'Yes. We do everything from small guest bath refreshes to full primary suite renovations. Small bathrooms in older Lufkin homes often get the most out of a new layout and modern fixtures.' },
  { q: 'What does a bathroom remodel cost in Lufkin, TX?', a: 'A basic bathroom refresh with new vanity, fixtures, and flooring typically runs $6,000 to $15,000 in the Lufkin area. A full custom tile shower renovation with new plumbing and layout changes can run $15,000 to $35,000+. We provide free, itemized estimates.' },
  { q: 'Can you put a walk-in shower in my existing bathroom?', a: 'Usually, yes. It\'s a common request. We look at the space, check whether the layout needs to change, then handle the tile, waterproofing and fixtures. Most conversions fit without making the room bigger.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Bathroom Remodeling in Lufkin TX',
    provider: { '@type': 'GeneralContractor', '@id': 'https://www.purposeconstructionco.com/#business', name: 'Purpose Construction', url: 'https://www.purposeconstructionco.com/' },
    areaServed: { '@type': 'City', name: 'Lufkin', containedInPlace: { '@type': 'State', name: 'Texas' } },
    description: 'Custom bathroom remodeling in Lufkin, TX. Showers, tubs, vanities, tile, and full bathroom renovations for Angelina County homeowners.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Bathroom Remodeling in Lufkin, TX | Purpose Construction"
  description="Bathroom remodeling in Lufkin, TX: walk-in showers, tile, vanities and full renovations. Insured, local crew. Free estimates: (936) 255-2235."
  schema={schema}
>
  <Breadcrumb items={[
    { label: 'Services', href: '/services/' },
    { label: 'Remodeling', href: '/remodeling-contractor/' },
    { label: 'Bathroom Remodeling', href: '/bathroom-remodeling/' },
  ]} />

  <PageHero
    title="Bathroom Remodeling in Lufkin, TX"
    subtitle="Purpose Construction remodels bathrooms across Lufkin and Angelina County: custom tile showers, vanity upgrades, full gut renovations, and everything in between."
    tag="Lufkin, TX"
    image="/images/bathroom-remodeling-lufkin-tx.jpg"
  />

  <div class="bg-charcoal-900 border-b border-charcoal-700">
    <div class="container-wide px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm font-semibold text-white">Serving Lufkin & Angelina County. Free on-site estimates, no obligation.</p>
      <div class="flex items-center gap-3">
        <a href="tel:9362552235" class="text-sm font-bold text-brand-red hover:text-white transition-colors duration-150">(936) 255-2235</a>
        <a href="/contact/" class="btn-primary py-2.5 text-xs">Get a Free Quote</a>
      </div>
    </div>
  </div>

  <section class="section-padding bg-warm-50">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading tag="Lufkin, TX" title="Bathroom Renovations Built for Lufkin Homes" />
          <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
            <p>Plenty of Lufkin homes still have their original bathrooms, with dated tile, cramped layouts and worn fixtures. Purpose Construction remodels these spaces into something modern and easy to live with.</p>
            <p>From a simple vanity and fixture swap to a full tile shower buildout or primary suite renovation, we handle the whole job: plumbing, tile, drywall, electrical, and finishes. Many homeowners pair bathroom remodels with <a href="/kitchen-remodeling/" class="text-brand-red hover:underline font-semibold">kitchen remodeling</a> or <a href="/flooring-installation/" class="text-brand-red hover:underline font-semibold">flooring installation</a> throughout the home.</p>
          </div>
          <div class="mt-6 flex gap-4">
            <a href="/contact/" class="btn-primary">Get a Free Estimate</a>
            <a href="tel:9362552235" class="btn-outline">Call (936) 255-2235</a>
          </div>
        </div>
        <div class="space-y-5">
          <img
            src="/images/bathroom-remodeling-lufkin-tx-800.webp"
            alt="Bathroom remodel by Purpose Construction in Lufkin, TX"
            class="rounded-xl shadow-hero w-full"
            width="640" height="480"
            loading="lazy" decoding="async"
          />
          <div class="rounded-xl border border-warm-200 bg-white p-5 shadow-card">
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-charcoal-400">Contact Information</p>
            <p class="text-base font-bold text-charcoal-900">Purpose Construction</p>
            <p class="mt-1 text-sm text-charcoal-600">Lufkin, TX · serving East Texas</p>
            <a href="tel:9362552235" class="mt-1 block text-sm font-semibold text-brand-red hover:text-brand-red-dark transition-colors duration-150">(936) 255-2235</a>
            <a href="mailto:info@purposeconstructionco.com" class="mt-0.5 block text-sm text-charcoal-500 hover:text-charcoal-800 transition-colors duration-150">info@purposeconstructionco.com</a>
            <div class="mt-3 border-t border-warm-200 pt-3 text-xs text-charcoal-500">
              <p>Mon to Sat: 8:00 AM to 6:00 PM</p>
              <p>Sunday: Closed</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="What We Handle" title="Full-Scope Bathroom Renovations" align="center" />
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {[
          'Shower Installation', 'Tub Replacement', 'Vanity & Fixtures',
          'Tile Flooring', 'Wall Tile', 'Lighting Upgrades',
          'Plumbing Rough-In', 'Exhaust Fan', 'Drywall & Paint',
          'Custom Shower Pan', 'Accessibility Upgrades', 'Permit Management',
        ].map((item) => (
          <div class="flex items-center gap-2 rounded-lg border border-warm-200 bg-warm-50 px-4 py-3 text-sm font-semibold text-charcoal-700">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-red" aria-hidden="true"></span>
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-warm-100 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Our Process" title="How a Bathroom Remodel Works in Lufkin" />
      <ol class="space-y-6">
        {[
          { step: '1', title: 'Free On-Site Consultation', body: 'We visit your Lufkin home, assess the bathroom, discuss your goals, and take measurements. No obligation.' },
          { step: '2', title: 'Written Proposal', body: 'You receive a detailed scope with itemized pricing, material specs, tile selections, and a project timeline.' },
          { step: '3', title: 'Permit & Planning', body: 'We pull the city permits the job needs and schedule subcontractors before demo day.' },
          { step: '4', title: 'Demo & Plumbing Rough', body: 'Existing fixtures, tile, and flooring come out. Plumbing rough-in is completed and inspected before walls close up.' },
          { step: '5', title: 'Tile, Fixtures & Finishes', body: 'Tile work, vanity, shower, tub, lighting, and all fixtures are installed and finished to spec.' },
          { step: '6', title: 'Final Walkthrough', body: 'We walk through the completed bathroom with you, address any items, and make sure you\'re fully satisfied.' },
        ].map((step) => (
          <li class="flex gap-6 items-start">
            <span class="flex-shrink-0 flex h-9 w-9 items-center justify-center rounded-full bg-brand-red text-white font-display font-bold text-sm" aria-hidden="true">{step.step}</span>
            <div>
              <h3 class="display-sm text-charcoal-900 mb-1">{step.title}</h3>
              <p class="text-sm leading-relaxed text-charcoal-500">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Common Questions" title="Bathroom Remodeling FAQs in Lufkin, TX" align="center" />
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-warm-200 bg-warm-50 shadow-card">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 list-none">
              <h3 class="text-sm font-semibold text-charcoal-800 pr-4">{faq.q}</h3>
              <svg class="h-5 w-5 flex-shrink-0 text-charcoal-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed text-charcoal-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-warm-50 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also in Lufkin" title="Related Services in Lufkin, TX" />
      <div class="flex flex-wrap gap-3">
        {[
          { label: 'Kitchen Remodeling', href: '/kitchen-remodeling/' },
          { label: 'Home Additions', href: '/home-additions/' },
          { label: 'Flooring Installation', href: '/flooring-installation/' },
          { label: 'Drywall Services', href: '/drywall-installation/' },
          { label: 'Remodeling Contractor', href: '/remodeling-contractor/' },
          { label: 'Construction Costs', href: '/construction-costs/' },
          { label: 'All Services', href: '/services/' },
        ].map((link) => (
          <a href={link.href} class="rounded-lg border border-warm-200 bg-white px-5 py-3 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-charcoal-900 transition-all duration-200">
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also Serving" title="Nearby Communities" />
      <div class="flex flex-wrap gap-3">
        <a href="/locations/nacogdoches/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Nacogdoches →</a>
        <a href="/locations/diboll/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Diboll →</a>
        <a href="/locations/huntington/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Huntington →</a>
        <a href="/locations/hudson/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Hudson →</a>
        <a href="/locations/zavalla/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Zavalla →</a>
        <a href="/locations/" class="rounded-lg border border-brand-red/30 bg-brand-red-light px-5 py-2.5 text-sm font-semibold text-brand-red hover:bg-brand-red hover:text-white transition-all duration-200">All Service Areas →</a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-red">
    <div class="container-mid px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="display-md text-white mb-4">Start Your Bathroom Remodel in Lufkin</h2>
      <p class="mx-auto mb-8 max-w-xl text-base text-white/80">Call us or fill out the contact form for a free on-site estimate. We serve Lufkin, Nacogdoches, Diboll, Huntington, and all of Angelina County.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact/" class="btn-ghost px-8 py-4">Get a Free Quote</a>
        <a href="tel:9362552235" class="text-sm font-semibold text-white/70 hover:text-white transition-colors duration-150">(936) 255-2235</a>
      </div>
    </div>
  </section>
</BaseLayout>
