---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Pole Barn Construction',
  provider: { '@type': 'GeneralContractor', '@id': 'https://www.purposeconstructionco.com/#business', name: 'Purpose Construction', url: 'https://www.purposeconstructionco.com/' },
  areaServed: { '@type': 'State', name: 'Texas', containedInPlace: { '@type': 'Country', name: 'United States' } },
  description: 'Pole barn construction across East Texas: post-frame buildings with metal roofing, metal siding, concrete slabs, roll-up doors, and optional electrical.',
};
---
<BaseLayout
  title="Pole Barn Construction in Lufkin, TX | Purpose Construction"
  description="Pole barn construction in Lufkin, TX: post-frame barns and shops with metal roofs, slabs and roll-up doors. Free estimates: (936) 255-2235."
  schema={schema}
>
  <Breadcrumb items={[{ label: 'Services', href: '/services/' }, { label: 'New Construction', href: '/new-construction/' }, { label: 'Pole Barn Construction', href: '/pole-barn-construction/' }]} />
  <PageHero title="Pole Barn Construction in Lufkin, TX" subtitle="Post-frame pole barns built for East Texas: farm storage, equipment shops, and working buildings that stand up to the weather for decades." tag="New Construction Service" 
    image="/images/pole-barn-construction-east-texas.jpg"
  />

  <section class="section-padding bg-warm-50">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading tag="Pole Barn Construction" title="Durable, Efficient Buildings for East Texas Land" />
          <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
            <p>For East Texas landowners, a pole barn is about as practical and affordable as buildings get. Farm storage, an equipment shop, a hay barn or an all-purpose work building: post-frame construction gives you a strong, long-lasting building for a fraction of what traditional construction costs. Purpose Construction builds pole barns across East Texas and Angelina County for farm, commercial, and residential use.</p>
            <p>We handle every phase, from site grading and the concrete slab to setting the posts, metal roofing, and metal siding. East Texas gets heavy rain and high winds in storm season, so we set posts right and use good fasteners that won't back out over time.</p>
            <p>We can add personnel doors, roll-up doors, windows, and electrical. Go as simple as an open-air equipment shelter or as far as a fully finished shop.</p>
          </div>
          <div class="mt-6 flex gap-4">
            <a href="/contact/" class="btn-primary">Get a Free Estimate</a>
            <a href="/new-construction/" class="btn-outline">All New Construction</a>
          </div>
        </div>
        <img src="/images/pole-barn-construction-east-texas-800.webp" alt="Pole barn construction across East Texas by Purpose Construction" class="rounded-xl shadow-hero" width="640" height="480" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="What's Included" title="Pole Barn Construction Services" align="center" />
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {['Post-Frame Design', 'Concrete Slab', 'Metal Roofing', 'Metal Siding', 'Roll-Up Doors', 'Personnel Doors', 'Windows', 'Electrical', 'Lean-To Additions'].map(item => (
          <div class="flex items-center gap-2 rounded-lg border border-warm-200 bg-warm-50 px-4 py-3 text-sm font-semibold text-charcoal-700">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-red" aria-hidden="true"></span>{item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-warm-50 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Related Services" title="Related Construction Services" />
      <div class="flex flex-wrap gap-3">
        {[{ label: 'Barndominium Construction', href: '/barndominium-construction/' }, { label: 'Site Preparation', href: '/site-preparation/' }, { label: 'Outdoor Living', href: '/outdoor-living/' }, { label: 'All New Construction', href: '/new-construction/' }].map(link => (
          <a href={link.href} class="rounded-lg border border-warm-200 bg-white px-5 py-3 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-charcoal-900 transition-all duration-200">{link.label} →</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-red">
    <div class="container-mid px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="display-md text-white mb-4">Ready to Build a Pole Barn?</h2>
      <p class="mx-auto mb-8 max-w-xl text-base text-white/80">Contact Purpose Construction for a free pole barn estimate. We build across East Texas.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact/" class="btn-ghost px-8 py-4">Get a Free Quote</a>
        <a href="tel:9362552235" class="text-sm font-semibold text-white/70 hover:text-white transition-colors duration-150">(936) 255-2235</a>
      </div>
    </div>
  </section>
</BaseLayout>
