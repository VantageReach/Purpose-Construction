---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';

const faqs = [
  { q: 'What door material works best in East Texas humidity?', a: 'Fiberglass and steel doors outperform wood doors in Lufkin\'s humid climate. Wood doors — especially those with poor finish maintenance — can swell, warp, and fail at the weather seal in East Texas humidity. Fiberglass doors mimic wood grain aesthetics without the dimensional instability. Steel doors are the most durable and lowest-maintenance option.' },
  { q: 'Do I need a permit to replace a door in Lufkin, TX?', a: 'Like-for-like door replacements in the same rough opening typically don\'t require a permit. Projects adding new door openings or modifying structural framing do. Purpose Construction assesses each project and handles any required City of Lufkin permits.' },
  { q: 'Can you install a new front door without replacing the frame?', a: 'In some cases, yes — if the existing frame and jamb are in good condition. In East Texas, older door frames frequently show moisture damage or wood rot at the sill and jamb base. We inspect the frame at the estimate and recommend replacement if needed for a proper, long-lasting installation.' },
  { q: 'How long does door installation take?', a: 'A single door replacement is typically completed in one day. Multi-door projects — replacing all exterior doors on a home — usually take 1–2 days. We provide a written schedule in every proposal.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Door Installation in Lufkin TX',
    provider: { '@type': 'GeneralContractor', '@id': 'https://www.purposeconstructionco.com/#business', name: 'Purpose Construction', url: 'https://www.purposeconstructionco.com/' },
    areaServed: { '@type': 'City', name: 'Lufkin', containedIn: { '@type': 'State', name: 'Texas' } },
    description: 'Door installation and replacement in Lufkin, TX. Entry doors, exterior doors, patio doors, and interior doors for Angelina County homeowners.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="Door Installation in Lufkin, TX | Purpose Construction"
  description="Door installation in Lufkin, TX: entry, patio, French and storm doors, framed and weathersealed right. Free estimates: (936) 255-2235."
  schema={schema}
>
  <Breadcrumb items={[
    { label: 'Services', href: '/services/' },
    { label: 'Exterior Services', href: '/exterior-services/' },
    { label: 'Door Installation', href: '/door-installation/' },
  ]} />

  <PageHero
    title="Door Installation in Lufkin, TX"
    subtitle="Purpose Construction installs and replaces exterior and interior doors for Lufkin and Angelina County homeowners — properly framed, weathersealed, and built to hold up in East Texas conditions."
    tag="Lufkin, TX"
    image="/images/door-installation-east-texas.jpg"
  />

  <div class="bg-charcoal-900 border-b border-charcoal-700">
    <div class="container-wide px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm font-semibold text-white">Serving Lufkin & Angelina County — Free on-site estimates, no obligation.</p>
      <div class="flex items-center gap-3">
        <a href="tel:9362552235" class="text-sm font-bold text-brand-red hover:text-white transition-colors duration-150">(936) 255-2235</a>
        <a href="/contact/" class="btn-primary py-2.5 text-xs">Get a Free Quote</a>
      </div>
    </div>
  </div>

  <section class="section-padding bg-warm-50">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading tag="Lufkin, TX" title="Door Replacement for Lufkin Homes" />
          <div class="space-y-4 text-base leading-relaxed text-charcoal-600">
            <p>Exterior doors take a beating in Lufkin's climate. Wood entry doors on older homes throughout the Lufkin area often show sill rot, jamb swelling, and failed weather stripping — all products of years of humidity cycling. Purpose Construction's door installation team replaces the full door unit when needed: door slab, frame, threshold, weatherstripping, and hardware — not just the door panel alone.</p>
            <p>We install fiberglass entry doors, steel exterior doors, French doors, sliding and hinged patio doors, and interior doors. Door replacement frequently pairs with <a href="/window-installation/" class="text-brand-red hover:underline font-semibold">window installation</a> or <a href="/siding-installation/" class="text-brand-red hover:underline font-semibold">siding replacement</a> as part of a complete exterior envelope upgrade.</p>
            <p>Most like-for-like door replacements don't require a permit. We inspect the existing frame and sill at the estimate — in Lufkin's climate, hidden rot at the jamb base is common and needs to be addressed before the new unit goes in.</p>
            <p>Storm doors are particularly practical in East Texas for adding a layer of insect protection during spring and fall when the weather is nice enough to leave the main door open. We install quality storm door units that complement your entry door and hold up through years of use.</p>
          </div>
          <div class="mt-6 flex gap-4">
            <a href="/contact/" class="btn-primary">Get a Free Estimate</a>
            <a href="tel:9362552235" class="btn-outline">Call (936) 255-2235</a>
          </div>
        </div>
        <div class="space-y-5">
          <img
            src="/images/door-installation-east-texas.jpg"
            alt="Door installation in Lufkin, TX by Purpose Construction"
            class="rounded-xl shadow-hero w-full"
            width="640" height="480"
            loading="lazy" decoding="async"
          />
          <div class="rounded-xl border border-warm-200 bg-white p-5 shadow-card">
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-charcoal-400">Contact Information</p>
            <p class="text-base font-bold text-charcoal-900">Purpose Construction</p>
            <p class="mt-1 text-sm text-charcoal-600">Lufkin, TX · serving East Texas</p>
            <a href="tel:9362552235" class="mt-1 block text-sm font-semibold text-brand-red hover:text-brand-red-dark transition-colors duration-150">(936) 255-2235</a>
            <a href="mailto:info@purposeconstructionco.com" class="mt-0.5 block text-sm text-charcoal-500 hover:text-charcoal-800 transition-colors duration-150">info@purposeconstructionco.com</a>
            <div class="mt-3 border-t border-warm-200 pt-3 text-xs text-charcoal-500">
              <p>Mon–Sat: 8:00 AM – 6:00 PM</p>
              <p>Sunday: Closed</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="What We Handle" title="Full-Scope Door Services" align="center" />
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {[
          'Entry Door Replacement', 'Fiberglass Doors', 'Steel Exterior Doors',
          'French Doors', 'Patio Door Replacement', 'Sliding Glass Doors',
          'Interior Door Replacement', 'Barn Doors', 'Storm Doors',
          'Frame & Jamb Repair', 'Weatherstripping', 'Hardware & Deadbolts',
        ].map((item) => (
          <div class="flex items-center gap-2 rounded-lg border border-warm-200 bg-warm-50 px-4 py-3 text-sm font-semibold text-charcoal-700">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-red" aria-hidden="true"></span>
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-warm-100 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Our Process" title="How Door Installation Works in Lufkin" />
      <ol class="space-y-6">
        {[
          { step: '1', title: 'Free On-Site Estimate', body: 'We measure existing openings, inspect frames and sills for rot or damage, and discuss door style, material, and hardware options.' },
          { step: '2', title: 'Written Proposal', body: 'Itemized scope with door product specs, frame repair work if needed, hardware selection, and project schedule.' },
          { step: '3', title: 'Order & Lead Time', body: 'Custom-sized or special-order doors have a 2–3 week lead time. Standard pre-hung units are typically available within a week.' },
          { step: '4', title: 'Removal & Frame Inspection', body: 'Existing door and frame removed. Rough opening inspected for rot, moisture damage, or out-of-plumb framing before new unit is set.' },
          { step: '5', title: 'Installation & Weathersealing', body: 'New door unit set, shimmed plumb and level, fastened, and fully weathersealed — threshold, jamb, and exterior caulk.' },
          { step: '6', title: 'Hardware & Final Walkthrough', body: 'Hardware installed, door tested for operation and weathertight seal. Final inspection with you before we leave.' },
        ].map((step) => (
          <li class="flex gap-6 items-start">
            <span class="flex-shrink-0 flex h-9 w-9 items-center justify-center rounded-full bg-brand-red text-white font-display font-bold text-sm" aria-hidden="true">{step.step}</span>
            <div>
              <h3 class="display-sm text-charcoal-900 mb-1">{step.title}</h3>
              <p class="text-sm leading-relaxed text-charcoal-500">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-warm-200">
    <div class="container-mid px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Common Questions" title="Door Installation FAQs — Lufkin, TX" align="center" />
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-warm-200 bg-warm-50 shadow-card">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 list-none">
              <h3 class="text-sm font-semibold text-charcoal-800 pr-4">{faq.q}</h3>
              <svg class="h-5 w-5 flex-shrink-0 text-charcoal-400 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-5 text-sm leading-relaxed text-charcoal-600">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-warm-50 border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also in Lufkin" title="Related Services in Lufkin, TX" />
      <div class="flex flex-wrap gap-3">
        {[
          { label: 'Window Installation', href: '/window-installation/' },
          { label: 'Siding Installation', href: '/siding-installation/' },
          { label: 'Exterior Painting', href: '/exterior-painting/' },
          { label: 'All Services', href: '/services/' },
        ].map((link) => (
          <a href={link.href} class="rounded-lg border border-warm-200 bg-white px-5 py-3 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-charcoal-900 transition-all duration-200">
            {link.label} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding-sm bg-white border-t border-warm-200">
    <div class="container-wide px-4 sm:px-6 lg:px-8">
      <SectionHeading tag="Also Serving" title="Nearby Communities" />
      <div class="flex flex-wrap gap-3">
        <a href="/locations/nacogdoches/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Nacogdoches →</a>
        <a href="/locations/diboll/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Diboll →</a>
        <a href="/locations/huntington/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Huntington →</a>
        <a href="/locations/hudson/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Hudson →</a>
        <a href="/locations/zavalla/" class="rounded-lg border border-warm-200 bg-warm-50 px-5 py-2.5 text-sm font-semibold text-charcoal-700 shadow-card hover:border-brand-red-mid hover:text-brand-red transition-all duration-200">Zavalla →</a>
        <a href="/locations/" class="rounded-lg border border-brand-red/30 bg-brand-red-light px-5 py-2.5 text-sm font-semibold text-brand-red hover:bg-brand-red hover:text-white transition-all duration-200">All Service Areas →</a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-red">
    <div class="container-mid px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="display-md text-white mb-4">Start Your Door Project in Lufkin</h2>
      <p class="mx-auto mb-8 max-w-xl text-base text-white/80">Call us or fill out the contact form for a free on-site estimate. We serve Lufkin, Nacogdoches, Diboll, Huntington, and all of Angelina County.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a href="/contact/" class="btn-ghost px-8 py-4">Get a Free Quote</a>
        <a href="tel:9362552235" class="text-sm font-semibold text-white/70 hover:text-white transition-colors duration-150">(936) 255-2235</a>
      </div>
    </div>
  </section>
</BaseLayout>
